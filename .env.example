# === Supabase ===
# URL проекта и anon-ключ: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role ключ — ТОЛЬКО для серверных роутов, никогда не отдаётся на клиент
SUPABASE_SERVICE_ROLE_KEY=

# === Вход ===
# Кнопка Google появится, только когда здесь стоит true И провайдер Google
# включён в Supabase — иначе она падала бы с «Unsupported provider».
NEXT_PUBLIC_GOOGLE_AUTH=false
# Вход по ссылке на почту включён по умолчанию. Выключайте (false), пока
# не настроен свой SMTP: встроенная почта Supabase и тестовый режим Resend
# шлют письма только владельцу проекта, остальные упрутся в ошибку.
NEXT_PUBLIC_EMAIL_AUTH=true

# === Админка ===
# Почты, которым открыта /admin. Несколько — через запятую.
# Пока пусто, админки нет ни у кого: панель меняет оплаченный доступ,
# и пустая переменная не должна случайно впустить первого встречного.
# Без NEXT_PUBLIC_: список не должен уезжать в браузер.
ADMIN_EMAILS=

# === Сайт ===
# Публичный URL сайта (для redirect после оплаты и писем подтверждения)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# === Оплата (NOWPayments) ===
# Ключ из кабинета: Settings -> Payments -> API keys
NOWPAYMENTS_API_KEY=
# Секрет оттуда же: Settings -> Payments -> Instant payment notifications.
# Это ДРУГОЙ ключ, не API-ключ: им подписываются уведомления об оплате.
NOWPAYMENTS_IPN_SECRET=
# Секрет для ручного открытия доступа через /api/billing/activate.
# Длинная случайная строка: openssl rand -hex 32
# Без неё маршрут закрыт полностью и доступ не откроет никому.
BILLING_WEBHOOK_SECRET=
