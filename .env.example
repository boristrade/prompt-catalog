# === Supabase ===
# URL проекта и anon-ключ: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role ключ — ТОЛЬКО для серверных роутов, никогда не отдаётся на клиент
SUPABASE_SERVICE_ROLE_KEY=

# === Вход ===
# Вход по ссылке на почту работает сразу, настраивать ничего не нужно.
# Кнопка Google появится, только когда здесь стоит true И провайдер Google
# включён в Supabase — иначе она падала бы с «Unsupported provider».
NEXT_PUBLIC_GOOGLE_AUTH=false

# === Админ ===
# E-mail пользователя, который получает роль admin
ADMIN_EMAIL=

# === ЮKassa ===
# shopId и секретный ключ: личный кабинет ЮKassa -> Интеграция -> Ключи API
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# === Сайт ===
# Публичный URL сайта (для redirect после оплаты и писем подтверждения)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
